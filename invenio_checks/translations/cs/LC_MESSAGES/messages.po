#: invenio_checks/templates/semantic-ui/invenio_checks/requests/file_formats_tab.html:25
msgid "The following files are not using open or scientific formats:"
msgstr "Následující soubory nejsou v otevřených ani vědeckých formátech:"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:9
msgid "Editing in progress"
msgstr "Úpravy probíhají"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:10
msgid "You're viewing checks and feedback results for unpublished changes."
msgstr "Zobrazujete výsledky kontrol a zpětné vazby k nepublikovaným změnám."

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:12
msgid ""
"The published version available to users may differ from what's shown here."
msgstr ""
"Publikovaná verze dostupná uživatelům se může lišit od toho, co je zde "
"zobrazeno."

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:18
msgid "What is this about?"
msgstr "O co jde?"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:19
msgid ""
"These checks help ensure that your submission is compliant with this "
"community's guidelines."
msgstr ""
"Tyto kontroly pomáhají zajistit, že váš odeslaný záznam splňuje pokyny této "
"komunity."

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:20
msgid "How do I fix warnings/errors?"
msgstr "Jak opravit varování nebo chyby?"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:21
msgid ""
"Go to the \"Record\" tab and click the orange \"Edit\" button. All errors "
"and recommendations are displayed inline in the upload form."
msgstr ""
"Přejděte na kartu \"Záznam\" a klikněte na oranžové tlačítko \"Upravit\". "
"Všechny chyby a doporučení se zobrazují přímo ve formuláři pro nahrání."
