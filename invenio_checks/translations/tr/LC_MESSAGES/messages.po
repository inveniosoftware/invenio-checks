#: invenio_checks/contrib/file_formats.py:92
msgid "File formats check"
msgstr "Dosya biçimi kontrolü"

#: invenio_checks/contrib/file_formats.py:94
msgid ""
"Validates that record files are in open and scientific formats, optionally "
"suggesting alternatives."
msgstr ""
"Kayıt dosyalarının açık ve bilimsel formatlarda olup olmadığını doğrular ve "
"isteğe bağlı olarak alternatifler önerir."

#: invenio_checks/contrib/file_formats.py:103
#, python-brace-format
msgid ".{ext} is not a known open or scientific file format."
msgstr ".{ext}, bilinen bir açık veya bilimsel dosya formatı değildir."

#: invenio_checks/contrib/file_formats.py:106
msgid ""
"Using closed or proprietary formats hinders reusability and preservation of "
"published files."
msgstr ""
"Kapalı veya tescilli formatların kullanılması, yayımlanan dosyaların yeniden"
" kullanılmasını ve korunmasını zorlaştırır."

#: invenio_checks/contrib/file_formats.py:108
msgid "All files should be in open or scientific formats"
msgstr "Tüm dosyalar açık veya bilimsel formatlarda olmalıdır."

#: invenio_checks/contrib/metadata/check.py:53
msgid "Metadata validation"
msgstr "Üst veri doğrulaması"

#: invenio_checks/contrib/metadata/check.py:54
msgid "Validates record metadata against configured rules."
msgstr "Kayıt üst verilerini yapılandırılmış kurallara göre doğrular."

#: invenio_checks/contrib/metadata/check.py:138
msgid "Unnamed check"
msgstr "Adsız kontrol"

#: invenio_checks/contrib/metadata/expressions.py:40
#, python-brace-format
msgid "Field {path} is required but missing"
msgstr "Zorunlu {path} alanı eksik."

#: invenio_checks/contrib/metadata/expressions.py:90
#, python-brace-format
msgid "Expected {path} to be {expected}, but got {actual}"
msgstr ""
"{path} alanının {expected} olması bekleniyordu, ancak {actual} değeri "
"alındı."

#: invenio_checks/contrib/metadata/expressions.py:91
#, python-brace-format
msgid "Expected {path} not to be {unexpected}, but got {actual}"
msgstr ""
"{path} alanının {unexpected} olmaması bekleniyordu, ancak {actual} değeri "
"alındı."

#: invenio_checks/contrib/metadata/expressions.py:92
#, python-brace-format
msgid "Expected {path} to contain {expected}, but got {actual}"
msgstr ""
"{path} alanının {expected} içermesi bekleniyordu, ancak {actual} değeri "
"alındı."

#: invenio_checks/contrib/metadata/expressions.py:93
#, python-brace-format
msgid "Expected {path} not to contain {unexpected}, but got {actual}"
msgstr ""
"{path} alanının {unexpected} içermemesi bekleniyordu, ancak {actual} değeri "
"alındı."

#: invenio_checks/contrib/metadata/expressions.py:94
#, python-brace-format
msgid "Expected {expected} in {path}, but got {actual}"
msgstr "{path} içinde {expected} bekleniyordu, ancak {actual} değeri alındı."

#: invenio_checks/contrib/metadata/expressions.py:95
#, python-brace-format
msgid "Expected {unexpected} to not be in {path}, but got {actual}"
msgstr ""
"{unexpected} değerinin {path} içinde olmaması bekleniyordu, ancak {actual} "
"değeri alındı."

#: invenio_checks/contrib/metadata/expressions.py:97
#, python-brace-format
msgid "Expected {path} to have at least {expected} {unit}, but got {actual}"
msgstr ""
"{path} alanının en az {expected} {unit} içermesi bekleniyordu, ancak "
"{actual} değeri alındı."

#: invenio_checks/contrib/metadata/expressions.py:100
#, python-brace-format
msgid "Expected {path} to have at most {expected} {unit}, but got {actual}"
msgstr ""
"{path} alanının en fazla {expected} {unit} içermesi bekleniyordu, ancak "
"{actual} değeri alındı."

#: invenio_checks/contrib/metadata/expressions.py:172
#: invenio_checks/contrib/metadata/expressions.py:202
#, python-brace-format
msgid "Cannot check if {type} contains a value"
msgstr "{type} türünün bir değer içerip içermediği kontrol edilemiyor."

#: invenio_checks/contrib/metadata/expressions.py:187
#: invenio_checks/contrib/metadata/expressions.py:217
#, python-brace-format
msgid "Cannot check if {type} does not contain a value"
msgstr "{type} öğesinin bir değer içerip içermediğini kontrol edilemiyor"

#: invenio_checks/contrib/metadata/expressions.py:227
#, python-brace-format
msgid "Expected {path} to start with {expected}"
msgstr "{path} değerinin {expected} ile başlaması bekleniyordu."

#: invenio_checks/contrib/metadata/expressions.py:233
#, python-brace-format
msgid "Cannot check if {type} starts with a value"
msgstr "{type} bir değerle başlayıp başlamadığı kontrol edilemiyor."

#: invenio_checks/contrib/metadata/expressions.py:242
#, python-brace-format
msgid "Expected {path} not to start with {unexpected}"
msgstr "{path} değerinin {unexpected} ile başlamaması bekleniyordu."

#: invenio_checks/contrib/metadata/expressions.py:248
#, python-brace-format
msgid "Cannot check if {type} doesn't start with a value"
msgstr "{type} bir değerle başlayıp başlamadığı kontrol edilemiyor."

#: invenio_checks/contrib/metadata/expressions.py:257
#, python-brace-format
msgid "Expected {path} to end with {expected}"
msgstr "{path} değerinin {expected} ile bitmesi bekleniyordu."

#: invenio_checks/contrib/metadata/expressions.py:263
#, python-brace-format
msgid "Cannot check if {type} ends with a value"
msgstr "{type} değerinin bir değerle bitip bitmediği kontrol edilemiyor."

#: invenio_checks/contrib/metadata/expressions.py:272
#, python-brace-format
msgid "Expected {path} not to end with {unexpected}"
msgstr "{path} değerinin {unexpected} ile bitmemesi bekleniyordu."

#: invenio_checks/contrib/metadata/expressions.py:278
#, python-brace-format
msgid "Cannot check if {type} doesn't end with a value"
msgstr ""
"{type} değerinin bir değerle bitmemiş olup olmadığı kontrol edilemiyor."

#: invenio_checks/contrib/metadata/expressions.py:287
#, python-brace-format
msgid "Unknown operator: {operator}"
msgstr "Bilinmeyen operator: {operator}"

#: invenio_checks/contrib/metadata/expressions.py:300
msgid "characters"
msgstr "karakterler"

#: invenio_checks/contrib/metadata/expressions.py:302
msgid "items"
msgstr "öğeler"

#: invenio_checks/contrib/metadata/expressions.py:304
msgid "value"
msgstr "değer"

#: invenio_checks/contrib/metadata/expressions.py:311
#, python-brace-format
msgid "Cannot check min for {type}"
msgstr "{type} için minimum kontrol edilemiyor."

#: invenio_checks/contrib/metadata/expressions.py:319
#, python-brace-format
msgid "Min threshold must be a number, got {type}"
msgstr "Minimum eşik değeri sayısal olmalıdır, alınan {type}"

#: invenio_checks/contrib/metadata/expressions.py:342
#, python-brace-format
msgid "Cannot check max for {type}"
msgstr "{type} için maksimum değer kontrol edilemiyor"

#: invenio_checks/contrib/metadata/expressions.py:350
#, python-brace-format
msgid "Max threshold must be a number, got {type}"
msgstr "Maksimum eşik değeri sayısal olmalıdır, alınan {type}"

#: invenio_checks/contrib/metadata/expressions.py:407
#, python-brace-format
msgid "Unknown logical operator: {operator}"
msgstr "Bilinmeyen mantıksal operatör: {operator}"

#: invenio_checks/contrib/metadata/expressions.py:417
#, python-brace-format
msgid "List field {path} is missing"
msgstr "{path} liste alanı eksik"

#: invenio_checks/contrib/metadata/expressions.py:418
#, python-brace-format
msgid "Field {path} is not a list"
msgstr "{path} alanı bir liste değil"

#: invenio_checks/contrib/metadata/expressions.py:419
#, python-brace-format
msgid "No items in list {path}"
msgstr "{path} listesinde öğe yok"

#: invenio_checks/contrib/metadata/expressions.py:420
#, python-brace-format
msgid "No items in {path} match the required criteria"
msgstr "{path} içindeki hiçbir öğe gerekli koşulları karşılamıyor"

#: invenio_checks/contrib/metadata/expressions.py:421
#, python-brace-format
msgid "Not all items in {path} match the required criteria"
msgstr "{path} içindeki tüm öğeler gerekli koşulları karşılamıyor"

#: invenio_checks/services/config.py:26
msgid "Ascending"
msgstr "Artan"

#: invenio_checks/services/config.py:27
msgid "Descending"
msgstr "Azalan"

#: invenio_checks/services/config.py:29
msgid "Title"
msgstr "Başlık"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/file_formats_tab.html:25
msgid "The following files are not using open or scientific formats:"
msgstr "Dosyalar açık veya bilimsel dosya biçimlerini kullanmamaktadır:"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:9
msgid "Editing in progress"
msgstr "Düzenleme devam ediyor"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:10
msgid "You're viewing checks and feedback results for unpublished changes."
msgstr ""
"Yayımlanmamış değişikliklere ait kontrol ve geri bildirim sonuçlarını "
"görüntülüyorsunuz."

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:12
msgid ""
"The published version available to users may differ from what's shown here."
msgstr ""
"Kullanıcılara sunulan yayımlanmış sürüm, burada gösterilen içerikten farklı "
"olabilir."

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:18
msgid "What is this about?"
msgstr "Bu ne hakkında?"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:19
msgid ""
"These checks help ensure that your submission is compliant with this "
"community's guidelines."
msgstr ""
"Bu kontroller, gönderinizin bu topluluğun yönergelerine uygun olmasını "
"sağlamaya yardımcı olur."

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:20
msgid "How do I fix warnings/errors?"
msgstr "Uyarıları/hataları nasıl düzeltebilirim?"

#: invenio_checks/templates/semantic-ui/invenio_checks/requests/help_message.html:21
msgid ""
"Go to the \"Record\" tab and click the orange \"Edit\" button. All errors "
"and recommendations are displayed inline in the upload form."
msgstr ""
"\"Kayıt\" sekmesine gidin ve turuncu \"Düzenle\" düğmesine tıklayın. Tüm "
"hatalar ve öneriler yükleme formunda satır içi olarak görüntülenir."
