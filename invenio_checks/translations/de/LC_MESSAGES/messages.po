#: invenio_checks/contrib/file_formats.py:92
msgid "File formats check"
msgstr "Prüfung der Dateiformate"

#: invenio_checks/contrib/file_formats.py:94
msgid ""
"Validates that record files are in open and scientific formats, optionally "
"suggesting alternatives."
msgstr ""
"Prüft, ob die Dateien des Datensatzes in offenen und wissenschaftlich "
"geeigneten Formaten vorliegen, und schlägt bei Bedarf Alternativen vor."

#: invenio_checks/contrib/file_formats.py:103
#, python-brace-format
msgid ".{ext} is not a known open or scientific file format."
msgstr ""
".{ext} ist kein bekanntes offenes oder wissenschaftlich geeignetes "
"Dateiformat."

#: invenio_checks/contrib/file_formats.py:106
msgid ""
"Using closed or proprietary formats hinders reusability and preservation of "
"published files."
msgstr ""
"Die Verwendung geschlossener oder proprietärer Dateiformate erschwert die "
"Nachnutzung und Langzeitarchivierung veröffentlichter Dateien."

#: invenio_checks/contrib/file_formats.py:108
msgid "All files should be in open or scientific formats"
msgstr ""
"Alle Dateien sollten in offenen oder wissenschaftlich geeigneten Formaten "
"vorliegen"

