#: invenio_checks/contrib/file_formats.py:92
msgid "File formats check"
msgstr "Kontroll av filformat"

#: invenio_checks/contrib/file_formats.py:94
msgid ""
"Validates that record files are in open and scientific formats, optionally "
"suggesting alternatives."
msgstr ""
"Validerar att filerna i posten är i öppna och vetenskapliga format och "
"föreslår eventuellt alternativ."

#: invenio_checks/contrib/file_formats.py:103
#, python-brace-format
msgid ".{ext} is not a known open or scientific file format."
msgstr ".{ext} är inte ett känt öppet eller vetenskapligt filformat."

#: invenio_checks/contrib/file_formats.py:106
msgid ""
"Using closed or proprietary formats hinders reusability and preservation of "
"published files."
msgstr ""
"Användning av slutna eller proprietära format hindrar återanvändbarhet och "
"bevarande av publicerade filer."

#: invenio_checks/contrib/file_formats.py:108
msgid "All files should be in open or scientific formats"
msgstr "Alla filer bör vara i öppna eller vetenskapliga format"

#: invenio_checks/contrib/metadata/check.py:53
msgid "Metadata validation"
msgstr "Metadatavalidering"

#: invenio_checks/contrib/metadata/check.py:54
msgid "Validates record metadata against configured rules."
msgstr "Validerar postens metadata mot konfigurerade regler."

#: invenio_checks/contrib/metadata/check.py:138
msgid "Unnamed check"
msgstr "Namnlös kontroll"

